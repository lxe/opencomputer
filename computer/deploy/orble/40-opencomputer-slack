#!/usr/bin/env bash
# Restore the local Slack gateway route when this Orble box resumes.
set -euo pipefail

[[ ${ORBLE_EVENT:-resume} == resume ]] || exit 0
if [[ ! -e /run/orble-opencomputer.ready ]]; then
  setsid /usr/local/sbin/opencomputer-box start </dev/null >>/var/log/opencomputer-box.log 2>&1 &
  timeout 30 sh -c 'until test -f /run/orble-opencomputer.ready; do sleep .25; done'
fi

install -d -m 0755 /run/lock
setsid flock -n /run/lock/orble-opencomputer-slack-gateway.lock \
  /usr/bin/socat TCP4-LISTEN:3170,bind=127.0.0.1,reuseaddr,fork TCP4:10.239.65.2:3170 \
  </dev/null >>/var/log/opencomputer-gateway-bridge.log 2>&1 &
